---
const explore = [
  { href: '#story', label: 'Our Space' },
  { href: '#menu', label: 'Full Menu' },
  { href: '#nights', label: 'What\'s On' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#instagram', label: 'Instagram' },
  { href: 'tel:07805011000', label: 'Call Now' },
];

const hours = [
  { day: 'Monday – Sunday', time: 'Open 24 hours' },
  { day: 'Every day of the week', time: 'No closing time' },
  { day: 'Peak hours', time: '6:00pm – 1:00am' },
];
---

<footer id="find-us" class="border-t px-6 pb-10 pt-16 md:px-16 lg:px-20" style="background: rgb(12,9,7); border-top-color: rgba(212,137,42,0.12);">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
    <!-- Brand -->
    <div>
      <p class="font-playfair text-xl italic font-bold tracking-[0.06em] text-amber">
        SHADOW <span class="text-cream">GAMING</span> CAFÉ
      </p>
      <p class="mt-4 max-w-xs text-sm font-light leading-relaxed text-cream-muted">
        Gaming, coffee and good company in Baghdad — PlayStation 5, PC, billiards, table tennis and
        hookah, open around the clock.
      </p>
      <div class="mt-6 flex gap-4">
        <a
          href="https://www.instagram.com/shadow_gamingcafe/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream-muted transition-colors duration-200 hover:text-amber"
          aria-label="Shadow Gaming Cafe on Instagram"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="tel:07805011000"
          class="text-cream-muted transition-colors duration-200 hover:text-amber"
          aria-label="Call Shadow Gaming Cafe"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Visit us -->
    <div>
      <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] not-italic text-amber" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Visit Us
      </h3>
      <address class="text-sm font-light not-italic leading-loose text-cream-muted">
        شارع فلسطين — تقاطع النخلة<br />
        Palestine Street, Baghdad<br />
        Baghdad Governorate, Iraq
      </address>
      <div class="mt-4 space-y-1 text-sm font-light text-cream-muted">
        <a href="tel:07805011000" class="block transition-colors hover:text-amber">0780 501 1000</a>
        <a href="tel:07765000200" class="block transition-colors hover:text-amber">0776 500 0200</a>
      </div>
      <a
        href="https://www.google.com/maps/search/?api=1&query=شارع+فلسطين+بغداد"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 flex h-[120px] w-[200px] max-w-full flex-col items-center justify-center gap-2 border px-4 text-center transition-colors hover:border-amber/60"
        style="background: rgb(22,17,13); border-color: rgba(212,137,42,0.2);"
      >
        <span class="text-2xl text-amber" aria-hidden="true">⌖</span>
        <span class="text-xs font-semibold text-amber">View on Google Maps →</span>
      </a>
    </div>

    <!-- Hours -->
    <div>
      <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] not-italic text-amber" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Opening Hours
      </h3>
      <dl class="text-sm font-light leading-loose text-cream-muted">
        {
          hours.map((h) => (
            <div class="flex justify-between gap-4 border-b border-amber/10 py-2">
              <dt>{h.day}</dt>
              <dd class="text-cream">{h.time}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.1em] text-amber">
        <span class="h-2 w-2 rounded-full bg-amber animate-pulse-dot"></span> Open now
      </p>
      <p class="mt-3 text-xs font-light italic text-cream-faint">
        Book the VIP room ahead on weekends.
      </p>
    </div>

    <!-- Explore -->
    <div>
      <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] not-italic text-amber" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Explore
      </h3>
      <nav aria-label="Footer" class="flex flex-col gap-3">
        {
          explore.map((link) => (
            <a
              href={link.href}
              class="text-sm font-light text-cream-muted transition-colors duration-200 hover:text-cream"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div
    class="mx-auto mt-12 flex max-w-6xl flex-wrap justify-between gap-4 border-t pt-8 text-xs text-cream-faint"
    style="border-top-color: rgba(212,137,42,0.08);"
  >
    <p>© 2024 Shadow Gaming Cafe. All rights reserved.</p>
    <p class="flex gap-3">
      <a href="#top" class="transition-colors hover:text-cream-muted">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="#top" class="transition-colors hover:text-cream-muted">Terms of Service</a>
    </p>
  </div>
</footer>