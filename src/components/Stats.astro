---
const stats = [
  { target: 5, decimals: 1, suffix: '★', label: 'Google Rating', delay: 0 },
  { target: 4, decimals: 0, suffix: '', label: 'Google Reviews', delay: 200 },
  { target: 1725, decimals: 0, suffix: '', label: 'Instagram Followers', delay: 400 },
];
---

<section
  id="stats"
  aria-label="Shadow Gaming Cafe in numbers"
  class="border-y px-6 py-14 md:py-16"
  style="background: rgb(22,17,13); border-color: rgba(212,137,42,0.12);"
>
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 md:flex md:flex-row md:flex-wrap md:justify-center md:gap-16 lg:gap-24">
    {
      stats.map((s) => (
        <div class="text-center">
          <p
            class="font-playfair italic leading-none"
            style="font-size: clamp(48px, 7vw, 96px); font-weight: 700; color: rgb(212,137,42);"
          >
            <span
              data-count={s.target}
              data-decimals={s.decimals}
              data-delay={s.delay}
              data-suffix={s.suffix}
            >
              {s.decimals ? s.target.toFixed(s.decimals) : s.target.toLocaleString('en-US')}
            </span>{s.suffix}
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream-muted">
            {s.label}
          </p>
        </div>
      ))
    }

    <div class="text-center">
      <p
        class="font-playfair italic leading-none"
        style="font-size: clamp(48px, 7vw, 96px); font-weight: 700; color: rgb(212,137,42);"
      >
        24/7
      </p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream-muted">
        Open Daily
      </p>
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.getElementById('stats');
  const counters = section ? Array.from(section.querySelectorAll<HTMLElement>('[data-count]')) : [];

  const format = (value: number, decimals: number) =>
    decimals > 0
      ? value.toFixed(decimals)
      : Math.round(value).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');

  const run = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.count || '0');
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const delay = parseInt(el.dataset.delay || '0', 10);
    const duration = 1600;

    if (reduced) {
      el.textContent = format(target, decimals);
      return;
    }

    window.setTimeout(() => {
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
        el.textContent = format(eased * target, decimals);
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, delay);
  };

  if (section && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            counters.forEach(run);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(section);
  } else {
    counters.forEach(run);
  }
</script>