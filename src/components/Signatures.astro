<section id="nights" class="px-6 py-24 md:px-16 lg:px-20" style="background: rgb(22,17,13);">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-14 max-w-lg">
      <p class="label mb-4">Nights at Shadow</p>
      <h2 style="font-size: clamp(32px, 4vw, 56px);">What Makes Us Different.</h2>
      <p class="mt-4 text-[17px] font-light text-cream-muted">
        Recurring nights, private rooms and deals we run every single week — nothing here is a
        one-off.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        cards.map((card, i) => (
          <article
            class="reveal group border transition-all duration-300 hover:scale-[1.02]"
            style={`transition-delay: ${i * 120}ms; background: rgb(12,9,7); border-color: rgba(212,137,42,0.1); border-radius: 0;`}
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={card.image}
                alt={card.alt}
                loading="lazy"
                class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                style="background: rgba(212,137,42,0.12);"
                aria-hidden="true"
              />
            </div>
            <div class="p-6">
              <span
                class="inline-block px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-amber"
                style="background: rgba(212,137,42,0.12); border-radius: 0;"
              >
                {card.badge}
              </span>
              <h3 class="mt-3 text-lg font-bold not-italic" style="font-family: 'Plus Jakarta Sans', sans-serif; color: rgb(245,237,224);">
                {card.name}
              </h3>
              <p class="mt-2 text-sm font-light leading-relaxed text-cream-muted">
                {card.description}
              </p>
              <p class="mt-4 text-base font-bold text-amber">{card.price}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>