const profileUrl = 'https://www.instagram.com/shadow_gamingcafe/';
const followers = '1,725';
---

<section id="instagram" class="px-6 py-24 md:px-16 lg:px-20" style="background: rgb(22,17,13);">
  <div class="mx-auto max-w-6xl">
    <!-- Header -->
    <div class="reveal mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="flex items-center gap-5">
        <img
          src={profile}
          alt="Shadow Gaming Café Instagram profile picture"
          class="h-16 w-16 rounded-full border border-amber/40 object-cover"
          loading="lazy"
          width="64"
          height="64"
        />
        <div>
          <p class="label mb-1">On Instagram</p>
          <h2 class="text-[26px] leading-tight md:text-[34px]">@shadow_gamingcafe</h2>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <span
              class="border border-amber/30 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-amber"
            >
              {followers} followers
            </span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-cream-faint">
              Shadow Gaming Càfe 🎮
            </span>
          </div>
        </div>
      </div>

      <a
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-amber"
        aria-label="Follow Shadow Gaming Cafe on Instagram"
      >
        Follow @shadow_gamingcafe
      </a>
    </div>

    <!-- Bio -->
    <p
      class="reveal mb-10 whitespace-pre-line border-l-[3px] pl-5 text-[15px] font-light leading-relaxed text-cream-muted"
      style="border-color: rgb(212,137,42); transition-delay: 80ms;"
      dir="auto"
    >{`مفتوح 24 ساعة | 7 أيام بالأسبوع🔹
🔹PS5 🎮-PC 🖥️
🔹Drinks ☕️ - Snacks 🍩
🔹Billirad 🎱 - Tennis Table 🏓
🔹Location: شارع فلسطين - تقاطع النخلة
🔹07765000200 📞`}</p>

    <!-- Grid -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        posts.map((post, i) => (
          <a
            href={profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal group relative block overflow-hidden border transition-all duration-300 hover:scale-[1.02] hover:border-amber/60"
            style={`transition-delay: ${i * 80}ms; background: rgb(12,9,7); border-color: rgba(212,137,42,0.1); border-radius: 0;`}
          >
            <div class="relative aspect-square overflow-hidden">
              <img
                src={post.image}
                alt={`Instagram post by @shadow_gamingcafe`}
                loading="lazy"
                class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-end bg-espresso/85 p-4 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-hover:opacity-100">
                <p
                  class="line-clamp-4 text-xs font-light leading-relaxed text-cream"
                  dir="auto"
                >
                  {post.caption}
                </p>
              </div>
              <span class="absolute right-3 top-3 flex items-center gap-1 bg-espresso/80 px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-amber opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                View ↗
              </span>
            </div>
            <p class="p-4 line-clamp-2 text-xs font-light leading-relaxed text-cream-muted" dir="auto">
              {post.caption}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>