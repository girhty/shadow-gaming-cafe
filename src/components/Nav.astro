---
const links = [
  { href: '#story', label: 'Our Space' },
  { href: '#menu', label: 'Play' },
  { href: '#nights', label: 'What\'s On' },
  { href: '#find-us', label: 'Find Us' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b backdrop-blur-md"
  style="background: rgba(13,11,9,0.85); border-bottom-color: rgba(212,137,42,0.12);"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center px-5 md:h-[72px] md:px-10 lg:px-20">
    <a
      href="#top"
      class="font-playfair text-[18px] italic font-bold tracking-[0.06em] text-amber md:text-[22px]"
    >
      SHADOW <span class="text-cream">GAMING</span> CAFÉ
    </a>

    <div class="flex-1"></div>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-[13px] font-semibold uppercase tracking-[0.08em] text-cream-muted transition-colors duration-200 hover:text-amber"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href="tel:07805011000" class="btn btn-amber ml-8 hidden lg:inline-flex">Call to Book</a>

    <button
      type="button"
      id="nav-toggle"
      class="ml-6 text-cream lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-drawer"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-sm translate-x-full overflow-y-auto px-6 py-6 transition-transform duration-300 ease-out lg:hidden"
    style="background: rgb(12,9,7);"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    hidden
  >
    <div class="flex items-center justify-between">
      <span class="font-playfair text-lg italic font-bold tracking-[0.06em] text-amber">SHADOW</span>
      <button type="button" id="nav-close" aria-label="Close menu" class="text-cream">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile" class="mt-8 flex flex-col">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="mobile-link border-b border-amber/10 py-5 text-[18px] font-normal text-cream transition-colors hover:text-amber"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="tel:07805011000"
        class="mobile-link mt-6 text-[18px] font-semibold text-amber"
      >
        0780 501 1000 →
      </a>
      <p class="mt-8 text-sm text-cream-faint">
        شارع فلسطين — تقاطع النخلة<br />Baghdad, Iraq
      </p>
      <p class="mt-3 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-amber">
        <span class="h-2 w-2 rounded-full bg-amber animate-pulse-dot"></span> Open 24 / 7
      </p>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const drawer = document.getElementById('mobile-drawer');

  const openDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.remove('translate-x-full'));
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    close?.focus();
  };

  const closeDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.classList.add('translate-x-full');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      if (drawer.classList.contains('translate-x-full')) drawer.hidden = true;
    }, 300);
    toggle.focus();
  };

  toggle?.addEventListener('click', openDrawer);
  close?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeDrawer();
  });
</script>