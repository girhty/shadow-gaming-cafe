---
import Card from './Card.astro';

const categories = [
  {
    id: 'gaming',
    label: 'Gaming',
    items: [
      {
        name: 'PC Gaming Rig',
        price: '2,000 IQD',
        meta: 'per hour',
        description:
          'High-refresh gaming PCs with headsets, ergonomic chairs and fibre internet. Built for FPS grinders, ranked nights and long sessions.',
      },
      {
        name: 'PlayStation 5 Station',
        price: '3,000 IQD',
        meta: 'per hour',
        description:
          'DualSense controllers, big-screen setup and a couch for the squad. FC, FIFA, Tekken, racing — your call.',
      },
      {
        name: 'VIP Gaming Room',
        price: '15,000 IQD',
        meta: 'private session',
        description:
          'A private room for four to six players with its own screen and sound. Perfect for birthdays, team nights and tournament warm-ups.',
      },
      {
        name: 'Squad Package · 4 players',
        price: '10,000 IQD',
        meta: '3 hours',
        description:
          'Four stations, three hours, drinks on the side. Weekend slots go fast — call ahead on 0780 501 1000.',
      },
    ],
  },
  {
    id: 'table',
    label: 'Table & Games',
    items: [
      {
        name: 'Billiard Table',
        price: '2,500 IQD',
        meta: 'per hour',
        description: 'Full-size table, proper cues, well kept. The quiet corner of the café.',
      },
      {
        name: 'Table Tennis',
        price: '1,500 IQD',
        meta: 'per hour',
        description: 'Rackets and balls provided. Friendly matches or full knockout brackets.',
      },
      {
        name: 'Cards, Dominos & Boards',
        price: 'Free',
        meta: 'with any drink',
        description:
          'Decks, dominos and backgammon boards are on the house with any hot or cold drink from the counter.',
      },
      {
        name: 'Hookah / Nargile',
        price: 'from 5,000 IQD',
        meta: 'prepared to order',
        description: 'Classic and fruit mixes, prepared fresh at the counter. 2+1 deal on Sundays.',
      },
    ],
  },
  {
    id: 'drinks',
    label: 'Drinks',
    items: [
      {
        name: 'Arabic Coffee',
        price: '1,000 IQD',
        description: 'Freshly ground, lightly cardamomed, served hot in small cups. Unlimited refills on VIP sessions.',
      },
      {
        name: 'Cappuccino',
        price: '2,000 IQD',
        description: 'Double shot, dense microfoam. The go-to for a 2am ranked climb.',
      },
      {
        name: 'Iced Latte',
        price: '2,500 IQD',
        description: 'Cold milk, espresso poured over, long ice. Clean and strong.',
      },
      {
        name: 'Energy Mocktail',
        price: '3,000 IQD',
        description: 'Citrus, mint and soda over crushed ice — built for the third extra-time.',
      },
      {
        name: 'Snacks & Donuts',
        price: 'from 1,000 IQD',
        description: 'Crisps, sandwiches, donuts and chocolate. Nothing that needs a knife and fork.',
      },
    ],
  },
  {
    id: 'deals',
    label: 'Deals',
    items: [
      {
        name: 'Sunday Play Deal',
        price: '2 + 1',
        meta: 'every Sunday',
        description: 'Order two hookahs and the third is on the house — plus hour bundles at the counter.',
      },
      {
        name: 'Play 2 Hours, Pay 1',
        price: '50% off',
        meta: 'Sundays',
        description: 'Play two hours and pay for one on any PC or PS5 station. Ask before you start.',
      },
      {
        name: 'Student Discount',
        price: '-25%',
        meta: 'with student ID',
        description:
          'Sixth-grade students get 25% off — show your student ID or official paperwork at the till.',
      },
      {
        name: 'Big-Screen Match Night',
        price: 'Free entry',
        meta: 'Gulf Cup · LaLiga · World Cup',
        description: 'Matches on the projector with the sound up. Kick-off times posted on our Instagram.',
      },
    ],
  },
];
---

<section id="menu" class="px-6 py-24 md:px-16 lg:px-20">
  <div class="mx-auto max-w-6xl">
    <!-- Section header -->
    <div class="reveal mb-14 text-center">
      <p class="label mb-4">What we offer</p>
      <h2>The Playground.</h2>
      <p class="mt-3 text-[17px] font-light text-cream-muted">
        Screens, tables, drinks and deals — all day, all night.
      </p>
    </div>

    <!-- Tabs -->
    <div class="tab-list reveal" role="tablist" aria-label="Menu categories" style="transition-delay: 120ms;">
      {
        categories.map((cat, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${cat.id}`}
            aria-controls={`panel-${cat.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
            data-tab={cat.id}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    {
      categories.map((cat, i) => (
        <div
          class="tab-panel"
          role="tabpanel"
          id={`panel-${cat.id}`}
          aria-labelledby={`tab-${cat.id}`}
          data-panel={cat.id}
          hidden={i !== 0}
        >
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {cat.items.map((item, index) => (
              <Card
                index={index}
                name={item.name}
                price={item.price}
                description={item.description}
                meta={item.meta}
              />
            ))}
          </div>
        </div>
      ))
    }

    <p class="mt-8 text-center text-xs text-cream-faint">
      Prices in Iraqi dinars. Booking recommended for the VIP room and weekend peak hours.
    </p>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

  const activate = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const selected = t === tab;
      t.setAttribute('aria-selected', String(selected));
      t.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((p) => {
      p.hidden = p.id !== tab.getAttribute('aria-controls');
    });
    tab.focus();
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      const key = e.key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft' && key !== 'Home' && key !== 'End') return;
      e.preventDefault();
      let next = index;
      if (key === 'ArrowRight') next = (index + 1) % tabs.length;
      if (key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      if (key === 'Home') next = 0;
      if (key === 'End') next = tabs.length - 1;
      activate(tabs[next]);
    });
  });
</script>