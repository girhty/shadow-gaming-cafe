---
interface Props {
  index?: number;
  name: string;
  price?: string;
  description?: string;
  meta?: string;
}

const { index = 0, name, price, description, meta } = Astro.props;
---

<article
  class="stagger-card border p-6 transition-colors duration-300 hover:border-amber/50"
  style={`--i:${index}; background: rgb(22,17,13); border-color: rgba(212,137,42,0.1); border-radius: 0;`}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-base font-semibold not-italic" style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; color: rgb(245,237,224);">
      {name}
    </h3>
    {
      price && (
        <span class="ml-auto whitespace-nowrap text-base font-bold text-amber">{price}</span>
      )
    }
  </div>
  {
    meta && (
      <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-cream-faint">{meta}</p>
    )
  }
  {description && <p class="mt-2 text-sm font-light leading-relaxed text-cream-muted">{description}</p>}
</article>