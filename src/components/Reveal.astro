---
interface Props {
  as?: 'div' | 'section' | 'article' | 'li';
  direction?: 'up' | 'left' | 'right';
  delay?: number;
  class?: string;
}

const { as: Tag = 'div', direction = 'up', delay = 0, class: className = '' } = Astro.props;

const dirClass =
  direction === 'left' ? 'reveal-left' : direction === 'right' ? 'reveal-right' : '';
---

<Tag class={`reveal ${dirClass} ${className}`} style={`transition-delay: ${delay}ms;`}>
  <slot />
</Tag>