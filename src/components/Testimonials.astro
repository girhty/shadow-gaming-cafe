---
const reviews = [
  {
    stars: 5,
    quote:
      'A beautiful, quiet, and suitable place — exactly the kind of spot you want to settle into for a long session.',
    name: 'Rainbow 2',
    detail: 'Google reviewer',
  },
  {
    stars: 5,
    quote: 'Beautiful place ✨',
    name: 'Zainab Mustafa',
    detail: 'Google reviewer',
  },
];

const otherReviewers = ['Mahdi Khuhduer', 'Suhayla Abbas'];
---

<section id="reviews" class="px-6 py-24 md:px-16 lg:px-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-16 text-center">
      <p class="label mb-4">What people say</p>
      <h2 style="font-size: clamp(28px, 3.5vw, 52px);">Rated 5.0 by Baghdad.</h2>

      <div
        class="mt-6 inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border px-5 py-3"
        style="border-color: rgba(212,137,42,0.3); background: rgb(22,17,13);"
      >
        <span class="font-playfair text-3xl font-bold italic text-amber">5.0</span>
        <span class="flex gap-1" role="img" aria-label="Rated 5 out of 5 stars">
          {
            Array.from({ length: 5 }).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="rgb(212,137,42)" aria-hidden="true">
                <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
              </svg>
            ))
          }
        </span>
        <span class="text-xs font-semibold uppercase tracking-[0.1em] text-cream-muted">
          on Google · 4 reviews
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        reviews.map((r, i) => (
          <figure
            class="reveal border-l-[3px] p-8"
            style={`transition-delay: ${i * 150}ms; background: rgb(22,17,13); border-color: rgb(212,137,42);`}
          >
            <div class="mb-5 flex gap-1" role="img" aria-label={`${r.stars} out of 5 stars`}>
              {Array.from({ length: r.stars }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="rgb(212,137,42)" aria-hidden="true">
                  <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                </svg>
              ))}
            </div>
            <blockquote class="mb-6 text-base font-light italic leading-[1.75] text-cream">
              “{r.quote}”
            </blockquote>
            <figcaption>
              <span class="block text-sm font-semibold text-cream">{r.name}</span>
              <span class="mt-1 block text-xs font-light text-cream-muted">{r.detail}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div
      class="reveal mt-8 flex flex-wrap items-center justify-center gap-3 border px-6 py-5 text-center"
      style="border-color: rgba(212,137,42,0.15); background: rgb(22,17,13); transition-delay: 300ms;"
    >
      <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-cream-faint">
        Also rated 5★ by
      </span>
      {
        otherReviewers.map((name) => (
          <span
            class="border border-amber/30 px-3 py-1 text-xs font-semibold text-amber"
            style="border-radius: 0;"
          >
            {name}
          </span>
        ))
      }
      <a
        href="https://www.google.com/maps/search/?api=1&query=شارع+فلسطين+بغداد+Shadow+Gaming+Cafe"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold text-cream-muted underline-offset-4 transition-colors hover:text-amber hover:underline"
      >
        Read all reviews →
      </a>
    </div>
  </div>
</section>